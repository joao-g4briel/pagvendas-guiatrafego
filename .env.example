# Copie para .env.local (desenvolvimento) ou cadastre na Vercel (Settings > Environment Variables).
# Todas as variáveis abaixo são públicas (NEXT_PUBLIC_*): não coloque senhas, tokens ou chaves privadas aqui.

# Endereço público do site, usado em metadados e Open Graph. Ex.: https://guia.metodaria.com.br
NEXT_PUBLIC_SITE_URL=

# Checkout da Cakto. Se ficar vazio, vale o valor padrão de src/config/site.ts.
NEXT_PUBLIC_CHECKOUT_URL=https://pay.cakto.com.br/tsduujj_1343853

# Encaminhar utm_* da página para o checkout. Ative ("true") só depois de confirmar que a Cakto aceita esses parâmetros.
NEXT_PUBLIC_CHECKOUT_FORWARD_UTM=false

# Medição opcional. Os rastreadores só carregam depois que o visitante aceita cookies de medição.
# GA4: ID de medição no formato G-XXXXXXXXXX
NEXT_PUBLIC_GA4_ID=
# Meta Pixel: ID numérico do conjunto de dados
NEXT_PUBLIC_META_PIXEL_ID=

# Contato de suporte exibido no FAQ, rodapé e páginas legais
NEXT_PUBLIC_SUPPORT_EMAIL=
# WhatsApp com DDI e DDD, só números. Ex.: 5581999999999
NEXT_PUBLIC_SUPPORT_WHATSAPP=
